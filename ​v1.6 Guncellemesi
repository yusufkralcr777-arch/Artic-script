-- [ HİLE AKTİFLİK DEĞİŞKENİ ]
local scriptEnabled = true

-- [ BALIK TUTMA SÜRESİ HIZLANDIRMA ] --
pcall(function()
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("NumberValue") or v:IsA("IntAttribute") or v:IsA("ValueBase") then
            local name = v.Name:lower()
            if scriptEnabled and (name:find("fish") or name:find("time") or name:find("cooldown") or name:find("delay")) then
                v.Value = 2
            end
        end
    end
end)

-- [ AĞAÇ IŞINLANMA FONKSİYONU ] --
local function teleportToTree()
    if not scriptEnabled then return end
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    local targetPart = nil
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        local name = obj.Name:lower()
        if name:find("tree") or name:find("wood") or name:find("log") or name:find("branch") then
            if obj:IsA("Model") and obj.PrimaryPart then
                targetPart = obj.PrimaryPart
                break
            elseif obj:IsA("BasePart") then
                targetPart = obj
                break
            end
        end
    end
    
    if targetPart then
        rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 4, 0)
        print("Ağaca başarıyla ışınlanıldı!")
    else
        warn("Ağaç bulunamadı!")
    end
end

