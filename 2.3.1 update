-- 5. BALIK SÜRESİ KİLİTLİ DÖNGÜ (ÇİFT KATMANLI - FLAWLESS)
local autoFishActive = false
local FishBtn = createButton("🎣 Balık Süresi: Normal", Color3.fromRGB(142, 68, 173))
FishBtn.MouseButton1Click:Connect(function()
    autoFishActive = not autoFishActive
    if autoFishActive then
        FishBtn.Text = "🎣 Balık Süresi: 2Sn (KİLİTLİ) ✅"
        FishBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
        
        task.spawn(function()
            while autoFishActive do
                pcall(function()
                    local searchAreas = {ReplicatedStorage, Workspace}
                    if LocalPlayer.Character then table.insert(searchAreas, LocalPlayer.Character) end
                    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
                    if bp then table.insert(searchAreas, bp) end
                    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                    if pg then table.insert(searchAreas, pg) end
                    
                    for _, area in ipairs(searchAreas) do
                        -- 1. Değer Nesnelerini Tarama (Value Objects)
                        for _, v in pairs(area:GetDescendants()) do
                            if v:IsA("NumberValue") or v:IsA("IntValue") then
                                local n = v.Name:lower()
                                if n:find("fish") or n:find("time") or n:find("delay") or n:find("cooldown") or n:find("wait") or n:find("bite") then
                                    if v.Value ~= 2 then 
                                        v.Value = 2 
                                    end
                                end
                            end
                        end
                        
                        -- 2. Özellikleri Tarama (Attributes)
                        local success, attrs = pcall(function() return area:GetAttributes() end)
                        if success and attrs then
                            for attrName, attrVal in pairs(attrs) do
                                local an = attrName:lower()
                                if an:find("fish") or an:find("time") or an:find("delay") or an:find("cooldown") or an:find("wait") or an:find("bite") then
                                    if type(attrVal) == "number" and attrVal ~= 2 then
                                        area:SetAttribute(attrName, 2)
                                    end
                                end
                            end
                        end
                    end
                end)
                task.wait(0.2) -- Tereyağından kıl çeker gibi hızlı ve sürekli tarama
            end
        end)
    else
        FishBtn.Text = "🎣 Balık Süresi: Normal"
        FishBtn.BackgroundColor3 = Color3.fromRGB(142, 68, 173)
    end
end)

