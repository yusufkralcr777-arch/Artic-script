-- [ 3. YARDIMCI FONKSİYONLAR ] --
local function strikeTarget()
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
        end
        local x = Workspace.CurrentCamera.ViewportSize.X / 2
        local y = Workspace.CurrentCamera.ViewportSize.Y / 2
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

local function equipTool(keywords)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not char or not bp then return false end
    
    for _, item in pairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local tn = item.Name:lower()
            for _, kw in ipairs(keywords) do
                if tn:find(kw) then return true end
            end
        end
    end
    
    for _, item in pairs(bp:GetChildren()) do
        if item:IsA("Tool") then
            local tn = item.Name:lower()
            for _, kw in ipairs(keywords) do
                if tn:find(kw) then
                    item.Parent = char
                    task.wait(0.15)
                    return true
                end
            end
        end
    end
    return false
end

-- [ 4. SİSTEMLER ] --
local autoFarmActive = false
local function toggleAutoFarm()
    autoFarmActive = not autoFarmActive
    task.spawn(function()
        while autoFarmActive do
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPart = char.HumanoidRootPart
                    local foundTree = false
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if not autoFarmActive then break end
                        if obj and obj.Parent and (obj:IsA("Model") or obj:IsA("BasePart")) then
                            local n = obj.Name:lower()
                            if (n:find("tree") or n:find("pine")) and not n:find("wood") then
                                local tPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                                if tPart and tPart.Parent and (tPart.Position - rootPart.Position).Magnitude < 400 then
                                    foundTree = true
                                    local treePos = tPart.Position
                                    
                                    rootPart.CFrame = tPart.CFrame * CFrame.new(0, 0, 3)
                                    rootPart.Anchored = true
                                    task.wait(0.1)
                                    
                                    local hasAxe = equipTool({"axe", "balta", "hatchet", "tool"})
                                    if not hasAxe then rootPart.Anchored = false break end
                                    
                                    rootPart.CFrame = CFrame.lookAt(rootPart.Position, Vector3.new(tPart.Position.X, tPart.Position.Y, tPart.Position.Z))
                                    
                                    while autoFarmActive and obj and obj.Parent and tPart and tPart.Parent do
                                        if (tPart.Position - rootPart.Position).Magnitude > 15 then break end
                                        strikeTarget()
                                        task.wait(0.6)
                                    end
                                    rootPart.Anchored = false
                                    
                                    if autoFarmActive then
                                        task.wait(0.8)
                                        for _, drop in pairs(Workspace:GetDescendants()) do
                                            if not autoFarmActive then break end
                                            if drop:IsA("BasePart") and not drop.Anchored then
                                                local dn = drop.Name:lower()
                                                if dn:find("wood") or dn:find("log") or dn:find("board") then
                                                    if (drop.Position - treePos).Magnitude < 30 then
                                                        rootPart.CFrame = drop.CFrame
                                                        task.wait(0.15)
                                                    end
                                                end
                                            end
                                        end
                                    end
                                    break
                                end
                            end
                        end
                    end
                    if not foundTree then task.wait(0.5) end
                end
            end)
            task.wait(0.2)
        end
    end)
end

local autoDigActive = false
local function toggleAutoDig()
    autoDigActive = not autoDigActive
    task.spawn(function()
        while autoDigActive do
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPart = char.HumanoidRootPart
                    local snowList = {}
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if obj and obj.Parent and (obj:IsA("Model") or obj:IsA("BasePart")) then
                            local n = obj.Name:lower()
                            if n:find("snow") or n:find("dig") or n:find("kar") or n:find("ice") or n:find("mound") or n:find("pile") then
                                local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                                if part and part.Parent and (part.Position - rootPart.Position).Magnitude < 300 then
                                    table.insert(snowList, {obj = obj, part = part, dist = (part.Position - rootPart.Position).Magnitude})
                                end
                            end
                        end
                    end
                    
                    if #snowList > 0 then
                        table.sort(snowList, function(a, b) return a.dist < b.dist end)
                        
                        local hasShovel = equipTool({"shovel", "kürek", "pick", "kazma", "snow"})
                        if hasShovel then
                            local digCount = 0
                            for _, item in ipairs(snowList) do
                                if not autoDigActive then break end
                                if digCount >= 7 then break end
                                
                                if item.obj and item.obj.Parent and item.part and item.part.Parent then
                                    rootPart.CFrame = item.part.CFrame * CFrame.new(0, 1.5, 2)
                                    rootPart.Anchored = true
                                    rootPart.CFrame = CFrame.lookAt(rootPart.Position, Vector3.new(item.part.Position.X, item.part.Position.Y, item.part.Position.Z))
                                    task.wait(0.05)
                                    
                                    strikeTarget()
                                    task.wait(0.2)
                                    
                                    rootPart.Anchored = false
                                    digCount = digCount + 1
                                end
                            end
                        end
                    else
                        task.wait(1)
                    end
                end
            end)
            task.wait(0.1)
        end
    end)
end

