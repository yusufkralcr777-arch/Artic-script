-- [ 3. YARDIMCI FONKSİYONLAR ] --
local savedHomePosition = nil
local function getHomePosition()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    if savedHomePosition then return savedHomePosition end
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj and obj.Name then
            local n = obj.Name:lower()
            if n:find("house") or n:find("base") or n:find("cabin") or n:find("home") or n:find("tent") then
                if obj:IsA("Model") and obj.PrimaryPart then
                    savedHomePosition = obj.PrimaryPart.CFrame
                    return savedHomePosition
                elseif obj:IsA("BasePart") then
                    savedHomePosition = obj.CFrame
                    return savedHomePosition
                end
            end
        end
    end
    savedHomePosition = character.HumanoidRootPart.CFrame + Vector3.new(5, 0, 5)
    return savedHomePosition
end

-- MOBİL ONAYLI TIKLAMA SİMÜLASYONU
local function simulateClick()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end

local function equipTool(toolNameKeywords)
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not character or not backpack then return false end
    
    for _, item in pairs(character:GetChildren()) do
        if item:IsA("Tool") then
            local tName = item.Name:lower()
            for _, kw in ipairs(toolNameKeywords) do
                if tName:find(kw) then return true end
            end
        end
    end
    
    for _, item in pairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            local tName = item.Name:lower()
            for _, kw in ipairs(toolNameKeywords) do
                if tName:find(kw) then
                    item.Parent = character
                    task.wait(0.4) 
                    return true
                end
            end
        end
    end
    return false
end

-- [ 4. AKILLI OTO AĞAÇ FARM VE ODUN TAŞIMA ] --
local autoFarmActive = false
local function toggleAutoFarm()
    autoFarmActive = not autoFarmActive
    task.spawn(function()
        while autoFarmActive do
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local rootPart = character.HumanoidRootPart
                local foundTree = false
                
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if not autoFarmActive then break end
                    if obj and obj.Parent and (obj:IsA("Model") or obj:IsA("BasePart")) then
                        local n = obj.Name:lower()
                        
                        -- Kesilmemiş sabit ağacı bulur
                        if (n:find("tree") or n:find("pine")) and not n:find("wood") then
                            local tPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            
                            if tPart and tPart.Parent and (tPart.Position - rootPart.Position).Magnitude < 400 then
                                foundTree = true
                                local treePos = tPart.Position -- Ağacın konumunu kaydet
                                
                                -- 1. Ağacın yanına git
                                rootPart.CFrame = tPart.CFrame * CFrame.new(0, 0, 3.5)
                                task.wait(0.4)
                                
                                -- 2. Baltayı kuşan
                                local hasAxe = equipTool({"axe", "balta", "hatchet", "tool"})
                                if not hasAxe then break end
                                
                                -- 3. Yüzünü ağaca dön
                                rootPart.CFrame = CFrame.lookAt(rootPart.Position, Vector3.new(tPart.Position.X, rootPart.Position.Y, tPart.Position.Z))
                                task.wait(0.2)
                                
                                -- 4. Ağaç tamamen yok olana kadar gerçekçi vur
                                while autoFarmActive and obj and obj.Parent and tPart and tPart.Parent do
                                    if (tPart.Position - rootPart.Position).Magnitude > 15 then break end
                                    simulateClick()
                                    task.wait(0.85)
                                end
                                
                                -- 5. Ağaç kesildi. Düşen odunları bekle ve eve gönder!
                                if autoFarmActive then
                                    task.wait(1.5) -- Odunların yere düşmesi için süre ver
                                    local homePos = getHomePosition()
                                    if homePos then
                                        -- Sadece o bölgedeki unanchored (hareket edebilen) odun parçalarını bul
                                        for _, drop in pairs(Workspace:GetDescendants()) do
                                            if drop:IsA("BasePart") and not drop.Anchored then
                                                local dn = drop.Name:lower()
                                                if dn:find("wood") or dn:find("log") or dn:find("board") then
                                                    -- Odun eski ağaç konumuna yakınsa bizimdir
                                                    if (drop.Position - treePos).Magnitude < 25 then
                                                        -- Odunları eve ışınla (Üst üste binmemesi için rastgele saç)
                                                        drop.CFrame = homePos + Vector3.new(math.random(-5, 5), 3, math.random(-5, 5))
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                                
                                task.wait(0.5)
                                break
                            end
                        end
                    end
                end
                if not foundTree then task.wait(1) end
            end
            task.wait(0.5)
        end
    end)
end

-- [ 5. AKILLI OTO KAR KAZMA ] --
local autoDigActive = false
local function toggleAutoDig()
    autoDigActive = not autoDigActive
    task.spawn(function()
        while autoDigActive do
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local rootPart = character.HumanoidRootPart
                local foundSnow = false
                
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if not autoDigActive then break end
                    if obj and obj.Parent and (obj:IsA("Model") or obj:IsA("BasePart")) then
                        local n = obj.Name:lower()
                        if n:find("snow") or n:find("dig") or n:find("kar") or n:find("ice") or n:find("mound") or n:find("pile") then
                            local part = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                            
                            if part and part.Parent and (part.Position - rootPart.Position).Magnitude < 300 then
                                foundSnow = true
                                
                                rootPart.CFrame = part.CFrame * CFrame.new(0, 0.5, 2.5)
                                task.wait(0.4)
                                
                                local hasShovel = equipTool({"shovel", "kürek", "pick", "kazma", "snow"})
                                if not hasShovel then break end
                                
                                rootPart.CFrame = CFrame.lookAt(rootPart.Position, Vector3.new(part.Position.X, rootPart.Position.Y, part.Position.Z))
                                task.wait(0.2)
                                
                                while autoDigActive and obj and obj.Parent and part and part.Parent do
                                    if (part.Position - rootPart.Position).Magnitude > 8 then break end
                                    simulateClick()
                                    task.wait(0.9)
                                end
                                
                                task.wait(0.5)
                                break
                            end
                        end
                    end
                end
                if not foundSnow then task.wait(1) end
            end
            task.wait(0.5)
        end
    end)
end

