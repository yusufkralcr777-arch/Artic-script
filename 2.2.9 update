local autoFishActive = false
local FishBtn = createButton("🎣 Oto Balık: Normal", Color3.fromRGB(142, 68, 173))
FishBtn.MouseButton1Click:Connect(function()
    autoFishActive = not autoFishActive
    if autoFishActive then
        FishBtn.Text = "🎣 Oto Balık: ANINDA (AÇIK) ✅"
        FishBtn.BackgroundColor3 = Color3.fromRGB(39, 174, 96)
        
        task.spawn(function()
            while autoFishActive do
                pcall(function()
                    local searchAreas = {ReplicatedStorage, Workspace}
                    if LocalPlayer.Character then table.insert(searchAreas, LocalPlayer.Character) end
                    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
                    if bp then table.insert(searchAreas, bp) end
                    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                    if pg then table.insert(searchAreas, pg) end
                    
                    for _, area in ipairs(searchAreas) do
                        for _, v in pairs(area:GetDescendants()) do
                            if v:IsA("NumberValue") or v:IsA("IntValue") then
                                local n = v.Name:lower()
                                if n:find("fish") or n:find("time") or n:find("delay") or n:find("cooldown") or n:find("wait") or n:find("bite") or n:find("progress") then
                                    if v.Value ~= 0 then v.Value = 0 end
                                end
                            end
                        end
                        
                        local success, attrs = pcall(function() return area:GetAttributes() end)
                        if success and attrs then
                            for attrName, attrVal in pairs(attrs) do
                                local an = attrName:lower()
                                if an:find("fish") or an:find("time") or an:find("delay") or an:find("cooldown") or an:find("wait") or an:find("bite") then
                                    if type(attrVal) == "number" and attrVal ~= 0 then
                                        area:SetAttribute(attrName, 0)
                                    end
                                end
                            end
                        end
                    end
                    
                    for _, folder in ipairs({ReplicatedStorage, Workspace}) do
                        for _, obj in pairs(folder:GetDescendants()) do
                            if obj:IsA("RemoteEvent") then
                                local n = obj.Name:lower()
                                if n:find("fish") or n:find("catch") or n:find("hook") or n:find("reel") or n:find("bite") then
                                    pcall(function() obj:FireServer() end)
                                    pcall(function() obj:FireServer("catch") end)
                                    pcall(function() obj:FireServer(true) end)
                                end
                            end
                        end
                    end
                    
                    if pg then
                        for _, gui in pairs(pg:GetDescendants()) do
                            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                                local gn = (gui.Name .. " " .. (gui.Text or "")):lower()
                                if gn:find("fish") or gn:find("catch") or gn:find("tut") or gn:find("çek") or gn:find("reel") then
                                    pcall(function()
                                        for _, conn in pairs(getconnections(gui.MouseButton1Click)) do
                                            conn:Fire()
                                        end
                                    end)
                                end
                            end
                        end
                    end
                end)
                task.wait(0.1)
            end
        end)
    else
        FishBtn.Text = "🎣 Oto Balık: Normal"
        FishBtn.BackgroundColor3 = Color3.fromRGB(142, 68, 173)
    end
end)

