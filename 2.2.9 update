-- 1. OTO AĞAÇ SİSTEMİ
local autoFarmActive = false
local function toggleAutoFarm()
    autoFarmActive = not autoFarmActive
    task.spawn(function()
        while autoFarmActive do
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPart = char.HumanoidRootPart
                    local foundTree = false
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if not autoFarmActive then break end
                        if obj and obj.Parent and (obj:IsA("Model") or obj:IsA("BasePart")) then
                            local n = obj.Name:lower()
                            if (n:find("tree") or n:find("pine") or n:find("ağaç") or n:find("trunk") or n:find("gövde")) and not n:find("wood") and not n:find("odun") then
                                local tPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                                if tPart and tPart.Parent and (tPart.Position - rootPart.Position).Magnitude < 400 then
                                    foundTree = true
                                    local treePos = tPart.Position
                                    
                                    rootPart.CFrame = tPart.CFrame * CFrame.new(0, 0, 4)
                                    task.wait(0.05)
                                    
                                    equipTool({"axe", "balta", "hatchet", "tool", "stone", "iron"})
                                    rootPart.CFrame = CFrame.lookAt(rootPart.Position, Vector3.new(tPart.Position.X, tPart.Position.Y, tPart.Position.Z))
                                    
                                    local strikeCount = 0
                                    while autoFarmActive and obj and obj.Parent and tPart and tPart.Parent do
                                        if (tPart.Position - rootPart.Position).Magnitude > 25 then break end
                                        strikeTarget()
                                        fireGameRemotes(tPart)
                                        task.wait(0.2)
                                        strikeCount = strikeCount + 1
                                        if strikeCount > 40 then break end
                                    end
                                    
                                    if autoFarmActive then
                                        task.wait(0.3)
                                        for _, drop in pairs(Workspace:GetDescendants()) do
                                            if not autoFarmActive then break end
                                            if drop:IsA("BasePart") and not drop.Anchored then
                                                local dn = drop.Name:lower()
                                                if dn:find("wood") or dn:find("log") or dn:find("board") or dn:find("odun") or dn:find("branch") then
                                                    if (drop.Position - treePos).Magnitude < 35 then
                                                        if savedHomeCFrame then
                                                            drop.CFrame = savedHomeCFrame + Vector3.new(math.random(-2,2), 1, math.random(-2,2))
                                                        else
                                                            drop.CFrame = rootPart.CFrame + Vector3.new(0, 2, 0)
                                                        end
                                                        task.wait(0.02)
                                                    end
                                                end
                                            end
                                        end
                                    end
                                    break
                                end
                            end
                        end
                    end
                    if not foundTree then task.wait(0.4) end
                end
            end)
            task.wait(0.15)
        end
    end)
end

-- 2. OTO KAZMA SİSTEMİ (7X GÜÇ)
local autoDigActive = false
local function toggleAutoDig()
    autoDigActive = not autoDigActive
    task.spawn(function()
        while autoDigActive do
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPart = char.HumanoidRootPart
                    local foundTarget = false
                    
                    local searchAreas = {ReplicatedStorage, Workspace}
                    if LocalPlayer.Character then table.insert(searchAreas, LocalPlayer.Character) end
                    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
                    if bp then table.insert(searchAreas, bp) end
                    
                    for _, area in ipairs(searchAreas) do
                        for _, v in pairs(area:GetDescendants()) do
                            if v:IsA("NumberValue") or v:IsA("IntValue") then
                                local n = v.Name:lower()
                                if n:find("yield") or n:find("multiplier") or n:find("power") or n:find("amount") or n:find("kazanc") or n:find("miktar") or n:find("dig") then
                                    if v.Value < 7 then v.Value = 7 end
                                end
                            end
                        end
                    end
                    
                    for _, prompt in pairs(Workspace:GetDescendants()) do
                        if not autoDigActive then break end
                        if prompt:IsA("ProximityPrompt") then
                            local parent = prompt.Parent
                            if parent then
                                local name = (parent.Name .. " " .. prompt.ActionText .. " " .. prompt.ObjectText):lower()
                                if name:find("snow") or name:find("kar") or name:find("dig") or name:find("kaz") or name:find("ice") or name:find("buz") or name:find("shovel") or name:find("kürek") then
                                    local targetPart = parent:IsA("BasePart") and parent or (parent:IsA("Model") and (parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")))
                                    if targetPart and (targetPart.Position - rootPart.Position).Magnitude < 300 then
                                        foundTarget = true
                                        rootPart.CFrame = targetPart.CFrame * CFrame.new(0, 2, 2)
                                        rootPart.Anchored = true
                                        task.wait(0.05)
                                        
                                        equipTool({"shovel", "kürek", "pick", "kazma", "snow", "ice", "tool"})
                                        pcall(function() fireproximityprompt(prompt) end)
                                        
                                        for i = 1, 6 do
                                            if not autoDigActive then break end
                                            strikeTarget()
                                            fireGameRemotes(targetPart)
                                            task.wait(0.04)
                                        end
                                        rootPart.Anchored = false
                                        break
                                    end
                                end
                            end
                        end
                    end
                    
                    if not foundTarget then task.wait(0.4) end
                end
            end)
            task.wait(0.15)
        end
    end)
end

