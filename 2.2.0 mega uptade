-- [ 3. EV KONUMUNU SABİTLEME ] --
local savedHomePosition = nil

local function getHomePosition()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    if savedHomePosition then return savedHomePosition end
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj and obj.Name then
            local n = obj.Name:lower()
            if n:find("house") or n:find("base") or n:find("cabin") or n:find("home") or n:find("tent") or n:find("shelter") then
                if obj:IsA("Model") and obj.PrimaryPart then
                    savedHomePosition = obj.PrimaryPart.CFrame
                    return savedHomePosition
                elseif obj:IsA("BasePart") then
                    savedHomePosition = obj.CFrame
                    return savedHomePosition
                end
            end
        end
    end
    savedHomePosition = character.HumanoidRootPart.CFrame + Vector3.new(5, 0, 5)
    return savedHomePosition
end

-- [ 4. BALTA KUŞANMA ] --
local function equipAxe()
    local character = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:FindFirstChild("Backpack")
    if not character or not backpack then return false end
    
    for _, item in pairs(character:GetChildren()) do
        if item:IsA("Tool") then return true end
    end
    
    for _, item in pairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            local tName = item.Name:lower()
            if tName:find("axe") or tName:find("balta") or tName:find("hatchet") or tName:find("tool") then
                item.Parent = character
                task.wait(0.1)
                return true
            end
        end
    end
    return false
end

-- [ 5. OTO AĞAÇ FARM (5 Vuruş & Hızlı) ] --
local autoFarmActive = false
local function toggleAutoFarm()
    autoFarmActive = not autoFarmActive
    task.spawn(function()
        while autoFarmActive do
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local rootPart = character.HumanoidRootPart
                local homePos = getHomePosition()
                local found = false
                
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if not autoFarmActive then break end
                    if obj then
                        local n = obj.Name:lower()
                        if n:find("tree") or n:find("wood") or n:find("log") then
                            local tPart = obj:IsA("Model") and obj.PrimaryPart or (obj:IsA("BasePart") and obj or nil)
                            if tPart and (tPart.Position - rootPart.Position).Magnitude < 500 then
                                found = true
                                rootPart.CFrame = tPart.CFrame + Vector3.new(0, 3, 2)
                                task.wait(0.2)
                                equipAxe()
                                
                                for _ = 1, 5 do
                                    if not autoFarmActive then break end
                                    pcall(function()
                                        local tool = character:FindFirstChildOfClass("Tool")
                                        if tool then tool:Activate() end
                                        for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                                            if remote:IsA("RemoteEvent") then
                                                local rn = remote.Name:lower()
                                                if rn:find("hit") or rn:find("chop") or rn:find("wood") or rn:find("damage") then
                                                    remote:FireServer(obj, tool)
                                                end
                                            end
                                        end
                                    end)
                                    task.wait(0.2)
                                end
                                
                                if tPart and homePos then
                                    pcall(function() tPart.CFrame = homePos + Vector3.new(3, 1, 3) end)
                                    rootPart.CFrame = homePos + Vector3.new(0, 3, 0)
                                end
                                task.wait(0.5)
                                break
                            end
                        end
                    end
                end
                if not found then task.wait(1) end
            end
            task.wait(0.2)
        end
    end)
end

-- [ 6. 3X AŞIRI BÜYÜK MEGA OTO-DİG (GECİKMESİZ & ANINDA) ] --
local autoDigActive = false
local function toggleAutoDig()
    autoDigActive = not autoDigActive
    task.spawn(function()
        while autoDigActive do
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local rootPart = character.HumanoidRootPart
                
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if not autoDigActive then break end
                    if obj and obj.Name then
                        local n = obj.Name:lower()
                        if n:find("snow") or n:find("dig") or n:find("kar") or n:find("ice") or n:find("mound") or n:find("pile") then
                            local part = obj:IsA("Model") and obj.PrimaryPart or (obj:IsA("BasePart") and obj or nil)
                            
                            -- Genişletilmiş mesafe (3 kat daha büyük alandakileri de yakalar)
                            if part and (part.Position - rootPart.Position).Magnitude < 150 then
                                pcall(function()
                                    -- 99 Robux 3x Mega Kazma Sinyali ve Anında Yok Etme
                                    for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                                        if remote:IsA("RemoteEvent") then
                                            local rn = remote.Name:lower()
                                            if rn:find("dig") or rn:find("shovel") or rn:find("snow") or rn:find("break") or rn:find("mine") then
                                                remote:FireServer(obj, "UltraMega3X")
                                            end
                                        end
                                    end
                                    
                                    -- 3 Kat Daha Büyük Boyut ve Anında Temizleme Efekti
                                    if obj:IsA("Model") then
                                        for _, p in pairs(obj:GetChildren()) do
                                            if p:IsA("BasePart") then
                                                p.Size = p.Size * 0.05 -- Anında eriyip küçülür
                                                p.Transparency = 0.8
                                                p.CanCollide = false
                                            end
                                        end
                                    elseif obj:IsA("BasePart") then
                                        obj.Size = obj.Size * 0.05
                                        obj.Transparency = 0.8
                                        obj.CanCollide = false
                                    end
                                end)
                            end
                        end
                    end
                end
            end
            task.wait(0.1) -- Beklemesiz, çok hızlı döngü
        end
    end)
end

