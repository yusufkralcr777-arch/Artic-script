-- [ 1. BALIK TUTMA VE SÜRE HIZLANDIRMA (2 SANİYE) ] --
local function speedUpFishing()
    pcall(function()
        for _, v in pairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("NumberValue") or v:IsA("IntAttribute") or v:IsA("ValueBase") then
                local name = v.Name:lower()
                if name:find("fish") or name:find("time") or name:find("cooldown") or name:find("delay") or name:find("wait") then
                    v.Value = 2
                end
            end
        end
    end)
end

-- [ 2. AĞACA IŞINLAN VE KIR ] --
local function teleportAndBreakTree()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    local targetPart = nil
    local targetModel = nil
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        local name = obj.Name:lower()
        if name:find("tree") or name:find("wood") or name:find("log") or name:find("branch") then
            if obj:IsA("Model") and obj.PrimaryPart then
                targetPart = obj.PrimaryPart
                targetModel = obj
                break
            elseif obj:IsA("BasePart") then
                targetPart = obj
                targetModel = obj.Parent
                break
            end
        end
    end
    
    if targetPart then
        rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.2)
        pcall(function()
            for _, v in pairs(ReplicatedStorage:GetDescendants()) do
                if v:IsA("RemoteEvent") then
                    local vName = v.Name:lower()
                    if vName:find("hit") or vName:find("chop") or vName:find("wood") or vName:find("gather") then
                        v:FireServer(targetModel)
                    end
                end
            end
        end)
    end
end

