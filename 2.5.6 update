-- 1. OTO AĞAÇ (DOKUNULMADI - ORİJİNAL HALİYLE HARİKA ÇALIŞIYOR)
local autoFarmActive = false
local function toggleAutoFarm()
    autoFarmActive = not autoFarmActive
    task.spawn(function()
        while autoFarmActive do
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPart = char.HumanoidRootPart
                    local targetTreeModel, targetTreePart = nil, nil
                    local shortestDist = math.huge
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if not autoFarmActive then break end
                        if obj and obj.Parent and (obj:IsA("Model") or obj:IsA("BasePart")) then
                            if not farmedTrees[obj] then
                                local n = obj.Name:lower()
                                if (n:find("tree") or n:find("pine") or n:find("ağaç") or n:find("trunk")) and not n:find("wood") and not n:find("odun") then
                                    local tPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                                    if tPart and tPart.Parent then
                                        local dist = (tPart.Position - rootPart.Position).Magnitude
                                        if dist < shortestDist and dist < 1000 then
                                            shortestDist = dist
                                            targetTreeModel = obj
                                            targetTreePart = tPart
                                        end
                                    end
                                end
                            end
                        end
                    end
                    
                    if targetTreeModel and targetTreePart and targetTreePart.Parent then
                        farmedTrees[targetTreeModel] = true
                        local treePos = targetTreePart.Position
                        
                        rootPart.CFrame = CFrame.new(treePos.X, treePos.Y - (targetTreePart.Size.Y / 2) + 1, treePos.Z) * CFrame.new(0, 0, 4)
                        task.wait(0.05)
                        equipTool({"axe", "balta", "hatchet", "tool"})
                        
                        local strikeCount = 0
                        while autoFarmActive and targetTreeModel and targetTreeModel.Parent and targetTreePart and targetTreePart.Parent do
                            if (targetTreePart.Position - rootPart.Position).Magnitude > 30 then break end
                            strikeTarget()
                            fireGameRemotes(targetTreePart)
                            task.wait(0.15)
                            strikeCount = strikeCount + 1
                            if strikeCount > 60 then break end
                        end
                        
                        if autoFarmActive then
                            task.wait(0.3)
                            for _, drop in pairs(Workspace:GetDescendants()) do
                                if not autoFarmActive then break end
                                if drop:IsA("BasePart") then
                                    local dn = drop.Name:lower()
                                    if dn:find("wood") or dn:find("log") or dn:find("odun") then
                                        if (drop.Position - treePos).Magnitude < 50 then
                                            pcall(function()
                                                for _, p in pairs(drop:GetDescendants()) do
                                                    if p:IsA("ProximityPrompt") then fireproximityprompt(p) end
                                                end
                                            end)
                                            fireGameRemotes(drop)
                                            if savedHomeCFrame then forceBringWoodHome(drop) end
                                        end
                                    end
                                end
                            end
                            if savedHomeCFrame then
                                rootPart.CFrame = savedHomeCFrame + Vector3.new(0, 3, 0)
                                task.wait(0.2)
                            end
                        end
                    else
                        farmedTrees = {}
                        task.wait(1)
                    end
                end
            end)
            task.wait(0.1)
        end
    end)
end

-- 2. OTO KAZMA
local autoDigActive = false
local function toggleAutoDig()
    autoDigActive = not autoDigActive
    task.spawn(function()
        while autoDigActive do
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPart = char.HumanoidRootPart
                    local foundAny = false
                    
                    equipTool({"shovel", "kürek", "pick", "kazma", "tool"})
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if not autoDigActive then break end
                        if obj and obj.Parent then
                            local n = obj.Name:lower()
                            if n:find("snow") or n:find("kar") or n:find("ice") or n:find("buz") or n:find("dig") or n:find("kaz") or n:find("rock") or n:find("stone") or n:find("mine") then
                                local p = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
                                if p and p.Parent and (p.Position - rootPart.Position).Magnitude < 40 then
                                    foundAny = true
                                    strikeTarget()
                                    fireGameRemotes(p)
                                    pcall(function()
                                        for _, prompt in pairs(p:GetDescendants()) do
                                            if prompt:IsA("ProximityPrompt") then fireproximityprompt(prompt) end
                                        end
                                    end)
                                end
                            end
                        end
                    end
                    
                    if not foundAny then
                        strikeTarget()
                        fireGameRemotes()
                    end
                end
            end)
            task.wait(0.08)
        end
    end)
end

-- 3. OTO BALIK / HIZLI YAKALAMA (DÜZELTİLDİ VE GÜÇLENDİRİLDİ)
local autoFishActive = false
local function toggleAutoFish()
    autoFishActive = not autoFishActive
    task.spawn(function()
        while autoFishActive do
            pcall(function()
                equipTool({"fish", "olta", "rod", "hook"})
                
                -- Oltayı sürekli açıp kapatmaması için sadece eldeki olta aktif değilse fırlatıyoruz
                local char = LocalPlayer.Character
                if char then
                    local tool = char:FindFirstChildOfClass("Tool")
                    if tool and (tool.Name:lower():find("fish") or tool.Name:lower():find("olta") or tool.Name:lower():find("rod")) then
                        pcall(function() tool:Activate() end)
                    end
                end
                
                -- Balık bekleme süresini hızlandırmak için tüm balık/yakalama remote'larını tetikle
                for _, folder in ipairs({ReplicatedStorage, Workspace}) do
                    for _, obj in pairs(folder:GetDescendants()) do
                        if obj:IsA("RemoteEvent") then
                            local n = obj.Name:lower()
                            if n:find("fish") or n:find("catch") or n:find("rod") or n:find("bite") or n:find("balık") or n:find("reel") then
                                pcall(function() obj:FireServer("InstantCatch") end)
                                pcall(function() obj:FireServer(true) end)
                                pcall(function() obj:FireServer() end)
                            end
                        end
                    end
                end
                
                -- Ekrana gelen balık yakalama / minigame butonlarına otomatik tıkla
                local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
                if pg then
                    for _, gui in pairs(pg:GetDescendants()) do
                        if gui:IsA("GuiObject") and gui.Visible then
                            local gn = (gui.Name .. " " .. (gui.Text or "")):lower()
                            if gn:find("fish") or gn:find("catch") or gn:find("tut") or gn:find("çek") or gn:find("reel") or gn:find("bite") or gn:find("!") then
                                pcall(function()
                                    if getconnections then
                                        for _, conn in pairs(getconnections(gui.MouseButton1Click)) do
                                            conn:Fire()
                                        end
                                    end
                                    local absPos = gui.AbsolutePosition
                                    local absSize = gui.AbsoluteSize
                                    VirtualInputManager:SendMouseButtonEvent(absPos.X + absSize.X/2, absPos.Y + absSize.Y/2, 0, true, game, 0)
                                    task.wait(0.01)
                                    VirtualInputManager:SendMouseButtonEvent(absPos.X + absSize.X/2, absPos.Y + absSize.Y/2, 0, false, game, 0)
                                end)
                            end
                        end
                    end
                end
            end)
            task.wait(0.4) -- Süre dengelendi: Oltayı hemen geri çekmez, balıkların daha hızlı gelmesini sağlar
        end
    end)
end

