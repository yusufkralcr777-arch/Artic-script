-- [ 3. YARDIMCI MOTORLAR ] --
local function strikeTarget()
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then tool:Activate() end
        end
        local cam = Workspace.CurrentCamera
        if cam then
            local x = cam.ViewportSize.X / 2
            local y = cam.ViewportSize.Y / 2
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end
    end)
end

local function fireGameRemotes(targetPart)
    pcall(function()
        for _, folder in ipairs({ReplicatedStorage, Workspace}) do
            for _, obj in pairs(folder:GetDescendants()) do
                if obj:IsA("RemoteEvent") then
                    local n = obj.Name:lower()
                    if n:find("chop") or n:find("cut") or n:find("hit") or n:find("damage") or n:find("tree") or n:find("wood") or n:find("tool") or n:find("dig") or n:find("snow") or n:find("mine") or n:find("fish") or n:find("catch") or n:find("collect") or n:find("ice") or n:find("rod") then
                        pcall(function() obj:FireServer(targetPart) end)
                        pcall(function() obj:FireServer() end)
                    end
                end
            end
        end
    end)
end

local function equipTool(keywords)
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not char or not bp then return false end
    
    for _, item in pairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local tn = item.Name:lower()
            for _, kw in ipairs(keywords) do
                if tn:find(kw) then return true end
            end
        end
    end
    
    for _, item in pairs(bp:GetChildren()) do
        if item:IsA("Tool") then
            local tn = item.Name:lower()
            for _, kw in ipairs(keywords) do
                if tn:find(kw) then
                    item.Parent = char
                    task.wait(0.05)
                    return true
                end
            end
        end
    end
    return false
end

local savedHomeCFrame = nil
local farmedTrees = {}

local function forceBringWoodHome(drop)
    if not savedHomeCFrame or not drop or not drop.Parent then return end
    task.spawn(function()
        local targetPos = savedHomeCFrame + Vector3.new(math.random(-4, 4), 1, math.random(-4, 4))
        local startTime = tick()
        while drop and drop.Parent and savedHomeCFrame and (tick() - startTime < 1.5) do
            pcall(function()
                drop.Anchored = true
                drop.CFrame = targetPos
            end)
            task.wait(0.05)
        end
        pcall(function()
            drop.Anchored = false
        end)
    end)
end

