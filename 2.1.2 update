-- [ GELİŞTİRİLMİŞ EV / ÜS BULMA FONKSİYONU (GARANTİLİ) ] --
local savedHomePosition = nil

local function getHomePosition()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then 
        return nil 
    end
    
    -- Eğer daha önce kaydedilmiş bir ev konumu varsa direkt onu döndür
    if savedHomePosition then
        return savedHomePosition
    end
    
    -- Haritada ev, üs veya kamp arama
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj and obj.Name then
            local nameLower = obj.Name:lower()
            if nameLower:find("house") or nameLower:find("base") or nameLower:find("cabin") or nameLower:find("home") or nameLower:find("tent") or nameLower:find("shelter") or nameLower:find("camp") then
                if obj:IsA("Model") and obj.PrimaryPart then
                    savedHomePosition = obj.PrimaryPart.CFrame
                    return savedHomePosition
                elseif obj:IsA("BasePart") then
                    savedHomePosition = obj.CFrame
                    return savedHomePosition
                end
            end
        end
    end
    
    -- Bulunamazsa karakterin ilk başladığı veya şu anki güvenli yerini baz al
    return character.HumanoidRootPart.CFrame + Vector3.new(4, 0, 4)
end

-- [ OTO FARM MOTORU (BEKLE + 5 VUR + TAŞI) ] --
local autoFarmActive = false

local function toggleAutoFarm()
    autoFarmActive = not autoFarmActive
    
    task.spawn(function()
        while autoFarmActive do
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("HumanoidRootPart") then
                local rootPart = character.HumanoidRootPart
                local homePos = getHomePosition()
                local targetFound = false
                
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if not autoFarmActive then break end
                    
                    if obj then
                        local nameLower = obj.Name:lower()
                        if nameLower:find("tree") or nameLower:find("wood") or nameLower:find("log") or nameLower:find("branch") then
                            local targetPart = nil
                            local targetModel = nil
                            
                            if obj:IsA("Model") and obj.PrimaryPart then
                                targetPart = obj.PrimaryPart
                                targetModel = obj
                            elseif obj:IsA("BasePart") then
                                targetPart = obj
                                targetModel = obj.Parent
                            end
                            
                            if targetPart and (targetPart.Position - rootPart.Position).Magnitude < 350 then
                                targetFound = true
                                
                                -- 1. AŞAMA: Ağacın yanına git ve konumda durup bekle
                                rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                                task.wait(0.8) -- Ağacın yanına varınca bekleme süresi
                                
                                -- 2. AŞAMA: Kesintisiz Tam 5 Kere Balta Vurma
                                for hitCount = 1, 5 do
                                    if not autoFarmActive then break end
                                    
                                    pcall(function()
                                        for _, remote in pairs(ReplicatedStorage:GetDescendants()) do
                                            if remote:IsA("RemoteEvent") then
                                                local rName = remote.Name:lower()
                                                if rName:find("hit") or rName:find("chop") or rName:find("wood") or rName:find("gather") or rName:find("tool") then
                                                    remote:FireServer(targetModel)
                                                end
                                            end
                                        end
                                    end)
                                    
                                    task.wait(0.9) -- Her vuruş arası balta sallama payı
                                end
                                
                                -- 3. AŞAMA: Evin önüne taşı ve ışınlan
                                if targetPart and homePos then
                                    pcall(function()
                                        targetPart.CFrame = homePos + Vector3.new(2, 1, 2)
                                    end)
                                    rootPart.CFrame = homePos + Vector3.new(0, 3, 0)
                                end
                                
                                task.wait(1.5)
                                break
                            end
                        end
                    end
                end
                
                if not targetFound then
                    task.wait(2)
                end
            end
            task.wait(1)
        end
    end)
end

