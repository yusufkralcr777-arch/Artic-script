local function AddLog(msg)
    local timestamp = os.date("%H:%M:%S")
    local entry = string.format("[%s] %s", timestamp, msg)
    table.insert(State.LogHistory, entry)
    if #State.LogHistory > 50 then
        table.remove(State.LogHistory, 1)
    end
    print("[Arctic Suite v2.5.9]: " .. msg)
end

local function GetCharacter()
    local char = LocalPlayer.Character
    if not char then return nil, nil, nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    return char, hrp, hum
end

local function ResetVelocity(hrp)
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function InstantTP(targetCFrame)
    local _, hrp = GetCharacter()
    if hrp and targetCFrame then
        ResetVelocity(hrp)
        hrp.CFrame = targetCFrame
        ResetVelocity(hrp)
    end
end

-- Noclip (Duvarlardan Geçme)
RunService.Stepped:Connect(function()
    if Config.WoodFarmEnabled or Config.OreFarmEnabled or Config.NoclipEnabled then
        local char = LocalPlayer.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end
end)

local function GetObjectPosition(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then
        return obj.Position
    elseif obj:IsA("Model") then
        if obj.PrimaryPart then
            return obj.PrimaryPart.Position
        else
            local part = obj:FindFirstChildWhichIsA("BasePart", true)
            if part then return part.Position end
        end
    end
    return nil
end

local function TriggerInteraction(obj)
    if not obj then return false end
    local _, hrp = GetCharacter()
    local success = false
    
    for _, prompt in pairs(obj:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function()
                prompt.HoldDuration = 0
                prompt.MaxActivationDistance = 99999
                fireproximityprompt(prompt)
                success = true
            end)
        end
    end
    
    for _, cd in pairs(obj:GetDescendants()) do
        if cd:IsA("ClickDetector") then
            pcall(function()
                fireclickdetector(cd)
                success = true
            end)
        end
    end
    
    if hrp then
        local targetPart = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)))
        if targetPart then
            pcall(function()
                firetouchinterest(hrp, targetPart, 0)
                firetouchinterest(hrp, targetPart, 1)
                success = true
            end)
        end
    end
    
    return success
end

local function EquipToolByKeywords(keywords)
    local char, _, hum = GetCharacter()
    if not char or not hum then return nil end
    
    for _, item in pairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local name = item.Name:lower()
            for _, key in ipairs(keywords) do
                if name:find(key) then return item end
            end
        end
    end
    
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local name = item.Name:lower()
                for _, key in ipairs(keywords) do
                    if name:find(key) then
                        hum:EquipTool(item)
                        task.wait(0.1)
                        return item
                    end
                end
            end
        end
    end
    return nil
end

local function GetBasePosition()
    if State.BaseCFrame then return State.BaseCFrame end
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        local name = obj.Name:lower()
        for _, key in ipairs(Config.BaseKeywords) do
            if name:find(key) then
                local pos = GetObjectPosition(obj)
                if pos then
                    State.BaseCFrame = CFrame.new(pos)
                    return State.BaseCFrame
                end
            end
        end
    end
    
    local _, hrp = GetCharacter()
    if hrp then
        State.BaseCFrame = hrp.CFrame
        return hrp.CFrame
    end
    return CFrame.new(0, 10, 0)
end

local function FindNearestTree()
    local _, hrp = GetCharacter()
    if not hrp then return nil end
    
    local nearestTree = nil
    local minDistance = 999999
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = obj.Name:lower()
            local isTree = false
            
            for _, key in ipairs(Config.TreeKeywords) do
                if name:find(key) then isTree = true break end
            end
            
            if isTree then
                local pos = GetObjectPosition(obj)
                if pos then
                    local dist = (pos - hrp.Position).Magnitude
                    if dist < minDistance then
                        minDistance = dist
                        nearestTree = {Object = obj, CFrame = CFrame.new(pos)}
                    end
                end
            end
        end
    end
    return nearestTree
end

-- EKSİKSİZ ODUN TAŞIMA DÖNGÜSÜ (BİRER BİRER VE HİÇBİRİNİ ATLAMADAN)
local function TransportAllWoodOneByOne(centerPos)
    local _, hrp = GetCharacter()
    if not hrp or not centerPos then return 0 end
    
    local baseCF = GetBasePosition()
    local processedLogs = {}
    local logsDelivered = 0
    local maxAttempts = 20
    local attempt = 0
    
    while Config.WoodFarmEnabled and attempt < maxAttempts do
        attempt = attempt + 1
        local closestLog = nil
        local minDist = Config.SweepRadius
        
        for _, obj in pairs(Workspace:GetDescendants()) do
            if (obj:IsA("BasePart") or obj:IsA("Model")) and not processedLogs[obj] then
                local name = obj.Name:lower()
                local isWood = false
                
                for _, key in ipairs(Config.WoodKeywords) do
                    if name:find(key) then isWood = true break end
                end
                
                if isWood then
                    local pos = GetObjectPosition(obj)
                    if pos then
                        local distFromTree = (pos - centerPos).Magnitude
                        if distFromTree <= Config.SweepRadius then
                            local distFromPlayer = (pos - hrp.Position).Magnitude
                            if distFromPlayer < minDist then
                                minDist = distFromPlayer
                                closestLog = {Object = obj, Position = pos}
                            end
                        end
                    end
                end
            end
        end
        
        if closestLog and Config.WoodFarmEnabled do
            processedLogs[closestLog.Object] = true
            
            -- 1. Odunun Dibine Işınlan
            InstantTP(CFrame.new(closestLog.Position + Vector3.new(0, 1.5, 0)))
            task.wait(0.12)
            
            -- 2. Odunu Al / Tut
            TriggerInteraction(closestLog.Object)
            task.wait(0.25)
            
            -- 3. Eve / Ateşe Işınlan ve Bırak
            if Config.AutoBringToBase then
                InstantTP(baseCF + Vector3.new(0, 2.5, 0))
                task.wait(0.15)
                
                for _, baseObj in pairs(Workspace:GetDescendants()) do
                    local name = baseObj.Name:lower()
                    for _, key in ipairs(Config.BaseKeywords) do
                        if name:find(key) then
                            TriggerInteraction(baseObj)
                        end
                    end
                end
                task.wait(0.15)
            end
            
            logsDelivered = logsDelivered + 1
            State.TotalWoodCollected = State.TotalWoodCollected + 1
            AddLog("Odun Alındı ve Ateşe Getirildi! (Adet: " .. logsDelivered .. ")")
        else
            break
        end
    end
    
    return logsDelivered
end

-- ANA AĞAÇ FARM DÖNGÜSÜ
local function StartWoodFarmLoop()
    task.spawn(function()
        AddLog("Eksiksiz Odun Taşıma Sistemli Farm Başlatıldı.")
        
        while Config.WoodFarmEnabled do
            local _, hrp = GetCharacter()
            if hrp then
                local axe = EquipToolByKeywords({"balta", "axe", "hatchet"})
                local tree = FindNearestTree()
                
                if tree then
                    AddLog("Ağaca Işınlanıldı: " .. tree.Object.Name)
                    InstantTP(tree.CFrame + Vector3.new(0, 2, 0))
                    task.wait(0.1)
                    
                    local chopCount = 0
                    while tree.Object and tree.Object.Parent and chopCount < 12 and Config.WoodFarmEnabled do
                        if axe then axe:Activate() end
                        TriggerInteraction(tree.Object)
                        task.wait(Config.ChopSpeed)
                        chopCount = chopCount + 1
                    end
                    
                    task.wait(0.3)
                    
                    -- DÜZELTİLEN TAŞIMA MEKANİZMASI
                    local delivered = TransportAllWoodOneByOne(tree.CFrame.Position)
                    AddLog("Ağaç Temizlendi. Toplam Taşınan Odun: " .. delivered)
                else
                    AddLog("Yeni Ağaç Aranıyor...")
                    task.wait(1)
                end
            end
            task.wait(0.1)
        end
        AddLog("Odun Farmı Durduruldu.")
    end)
end

-- HIZLI BALIK TUTMA
local function StartFastFishingLoop()
    task.spawn(function()
        AddLog("Hızlı Balık Tutma (Fast Fishing) Başlatıldı.")
        while Config.FastFishingEnabled do
            pcall(function()
                local rod = EquipToolByKeywords(Config.FishKeywords)
                local char, hrp = GetCharacter()
                if rod and char then
                    rod:Activate()
                    task.wait(Config.FishingDelay)
                    for _, v in pairs(Workspace:GetDescendants()) do
                        local name = v.Name:lower()
                        if name:find("bobber") or name:find("hook") or name:find("fish") then
                            TriggerInteraction(v)
                        end
                    end
                    rod:Activate()
                    State.TotalFishCaught = State.TotalFishCaught + 1
                    AddLog("Balık Tutuldu! Toplam: " .. State.TotalFishCaught)
                end
            end)
            task.wait(0.25)
        end
        AddLog("Balık Tutma Durduruldu.")
    end)
end

-- HAYATTA KALMA SİSTEMİ
local function StartSurvivalLoop()
    task.spawn(function()
        while true do
            pcall(function()
                if Config.AutoWarmth then
                    local baseCF = GetBasePosition()
                    local _, hrp = GetCharacter()
                    if hrp and (hrp.Position - baseCF.Position).Magnitude > 120 then
                        AddLog("Donma Tehlikesi! Eve / Ateşe Işınlanılıyor...")
                        InstantTP(baseCF + Vector3.new(0, 2, 0))
                    end
                end
            end)
            task.wait(6)
        end
    end)
end
StartSurvivalLoop()

