-- GÜÇLENDİRİLMİŞ ODUNU EVE TAŞIMA FONKSİYONU
local function forceBringWoodHome(drop)
    if not savedHomeCFrame or not drop or not drop.Parent then return end
    task.spawn(function()
        local targetPos = savedHomeCFrame + Vector3.new(math.random(-5, 5), 1, math.random(-5, 5))
        local startTime = tick()
        while drop and drop.Parent and savedHomeCFrame and (tick() - startTime < 1.5) do
            pcall(function()
                drop.Anchored = true
                drop.CFrame = targetPos
                pcall(function() drop:SetNetworkOwner(LocalPlayer) end)
            end)
            task.wait(0.05)
        end
        pcall(function()
            drop.Anchored = false
            drop.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            drop.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end)
    end)
end

-- 1. OTO AĞAÇ & GÜÇLENDİRİLMİŞ ODUN TAŞIMA
local autoFarmActive = false
local function toggleAutoFarm()
    autoFarmActive = not autoFarmActive
    task.spawn(function()
        while autoFarmActive do
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPart = char.HumanoidRootPart
                    local targetTreeModel = nil
                    local targetTreePart = nil
                    local shortestDist = math.huge
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if not autoFarmActive then break end
                        if obj and obj.Parent and (obj:IsA("Model") or obj:IsA("BasePart")) then
                            if not farmedTrees[obj] then
                                local n = obj.Name:lower()
                                if (n:find("tree") or n:find("pine") or n:find("ağaç") or n:find("trunk") or n:find("gövde")) and not n:find("wood") and not n:find("odun") then
                                    local tPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or obj
                                    if tPart and tPart.Parent then
                                        local dist = (tPart.Position - rootPart.Position).Magnitude
                                        if dist < shortestDist and dist < 1000 then
                                            shortestDist = dist
                                            targetTreeModel = obj
                                            targetTreePart = tPart
                                        end
                                    end
                                end
                            end
                        end
                    end
                    
                    if targetTreeModel and targetTreePart and targetTreePart.Parent then
                        farmedTrees[targetTreeModel] = true
                        local treePos = targetTreePart.Position
                        
                        local rootCFrame = CFrame.new(treePos.X, treePos.Y - (targetTreePart.Size.Y / 2) + 1, treePos.Z) * CFrame.new(0, 0, 4)
                        rootPart.CFrame = rootCFrame
                        task.wait(0.05)
                        
                        equipTool({"axe", "balta", "hatchet", "tool", "stone", "iron"})
                        rootPart.CFrame = CFrame.lookAt(rootPart.Position, Vector3.new(treePos.X, rootPart.Position.Y, treePos.Z))
                        
                        local strikeCount = 0
                        while autoFarmActive and targetTreeModel and targetTreeModel.Parent and targetTreePart and targetTreePart.Parent do
                            if (targetTreePart.Position - rootPart.Position).Magnitude > 35 then break end
                            strikeTarget()
                            fireGameRemotes(targetTreePart)
                            task.wait(0.15)
                            strikeCount = strikeCount + 1
                            if strikeCount > 70 then break end
                        end
                        
                        if autoFarmActive then
                            task.wait(0.4)
                            for _, drop in pairs(Workspace:GetDescendants()) do
                                if not autoFarmActive then break end
                                if drop:IsA("BasePart") then
                                    local dn = drop.Name:lower()
                                    if dn:find("wood") or dn:find("log") or dn:find("board") or dn:find("odun") or dn:find("branch") then
                                        if (drop.Position - treePos).Magnitude < 65 then
                                            -- ProximityPrompt tetikle
                                            for _, prompt in pairs(drop:GetDescendants()) do
                                                if prompt:IsA("ProximityPrompt") then
                                                    pcall(function() fireproximityprompt(prompt) end)
                                                end
                                            end
                                            
                                            fireGameRemotes(drop)
                                            
                                            -- Evi kaydettiyse oraya taşı
                                            if savedHomeCFrame then
                                                forceBringWoodHome(drop)
                                            end
                                        end
                                    end
                                end
                            end
                            
                            if savedHomeCFrame then
                                rootPart.CFrame = savedHomeCFrame + Vector3.new(0, 3, 0)
                                task.wait(0.3)
                            end
                        end
                    else
                        farmedTrees = {}
                        task.wait(1)
                    end
                end
            end)
            task.wait(0.1)
        end
    end)
end

-- 2. OTO KAZMA SİSTEMİ
local autoDigActive = false
local function toggleAutoDig()
    autoDigActive = not autoDigActive
    task.spawn(function()
        while autoDigActive do
            pcall(function()
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    local rootPart = char.HumanoidRootPart
                    local foundTarget = false
                    
                    for _, obj in pairs(Workspace:GetDescendants()) do
                        if not autoDigActive then break end
                        if obj and obj.Parent then
                            local n = obj.Name:lower()
                            if n:find("snow") or n:find("kar") or n:find("dig") or n:find("kaz") or n:find("ice") or n:find("buz") or n:find("mine") or n:find("rock") or n:find("stone") then
                                local tPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
                                if tPart and (tPart.Position - rootPart.Position).Magnitude < 400 then
                                    foundTarget = true
                                    rootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                                    rootPart.CFrame = tPart.CFrame + Vector3.new(0, 6, 0)
                                    task.wait(0.05)
                                    equipTool({"shovel", "kürek", "pick", "kazma", "snow", "ice", "tool"})
                                    rootPart.CFrame = CFrame.lookAt(rootPart.Position, Vector3.new(tPart.Position.X, tPart.Position.Y, tPart.Position.Z))
                                    
                                    for i = 1, 8 do
                                        if not autoDigActive then break end
                                        strikeTarget()
                                        fireGameRemotes(tPart)
                                        task.wait(0.03)
                                    end
                                    break
                                end
                            end
                        end
                    end
                    if not foundTarget then task.wait(0.3) end
                end
            end)
            task.wait(0.1)
        end
    end)
end

